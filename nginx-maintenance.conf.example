# Morel Technology - mantenimiento automático con Nginx
# Ahora maintenance.html ya llega al server con cada deploy (el workflow
# rsync lo copia a /home/<user>/moreltechnology/app/maintenance.html),
# así que Nginx puede servirlo directo desde ahí, sin copias manuales.
#
# Único paso en el server (una sola vez): pegar este bloque dentro del
# bloque `server { ... }` de moreltechnologyrd.com al lado de tu proxy.
# Luego: nginx -t && nginx -s reload
#
# Cuando la app responda 502/503/504 (contenedor caido, deploy, build),
# Nginx entrega maintenance.html con status 503. La pagina reintenta sola
# cada 15s y recarga al sitio real cuando la app vuelve a responder.

# Ajusta el puerto si tu app escucha en otro.
# En el paso de rebuild, el workflow hace docker-compose down -> build -> up,
# asi que en ese hueco el usuario verá la página de mantenimiento.

location / {
    proxy_pass http://127.0.0.1:3333;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    # Intercepta errores del upstream y muestra la pagina de mantenimiento
    proxy_intercept_errors on;
    error_page 502 503 504 =503 /maintenance.html;
}

# maintenance.html es interno: solo se sirve via error_page, nunca se navega directo.
location = /maintenance.html {
    alias /home/<USER>/moreltechnology/app/maintenance.html;
    internal;
}

# Sirve el logo de la app como estático. Funciona con la app arriba
# (sirve el real) y durante el mantenimiento (para el img de la pagina).
location ^~ /logo/ {
    root /home/<USER>/moreltechnology/app/public;
}