# Morel Technology - mantenimiento automático con Nginx
# Copia este bloque dentro del bloque `server { ... }` que maneja
# moreltechnologyrd.com (al lado de tu config SSL y proxy).
#
# Instrucciones:
#   1. Copia maintenance.html al host:
#      mkdir -p /etc/nginx/maintenance && cp maintenance.html /etc/nginx/maintenance/maintenance.html
#   2. Pega el bloque de abajo (error_page + location) dentro de tu `server`.
#   3. nginx -t && nginx -s reload  (o systemctl reload nginx)
#
# Cuando la app responda 502/503/504 (contenedor caido, deploy, build),
# Nginx entrega maintenance.html con status 503. La pagina reintenta sola
# cada 15s y recarga al sitio real cuando la app vuelve a responder.

# Dentro de tu server de moreltechnologyrd.com:
location / {
    proxy_pass http://127.0.0.1:3333;          # ajusta al puerto de tu app
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    # Intercepta errores del upstream y muestra la pagina de mantenimiento
    proxy_intercept_errors on;
    error_page 502 503 504 =503 /maintenance.html;
}

# maintenance.html es interno: solo se sirve via error_page, nunca se navega directo.
location = /maintenance.html {
    alias /etc/nginx/maintenance/maintenance.html;
    internal;
}