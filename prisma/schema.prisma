generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SubscriptionSource {
  WEBSITE
  CHECKOUT
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TIKTOK
  REFERAL
}

model NewsletterSubscriber {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  status          SubscriberStatus   @default(SUBSCRIBED)
  source          SubscriptionSource @default(WEBSITE)
  consentGivenAt  DateTime           @db.Timestamptz
  consentVersion  String             @default("v1")
  subscribedAt    DateTime           @default(now()) @db.Timestamptz
  unsubscribedAt  DateTime?          @db.Timestamptz
  createdAt       DateTime           @default(now()) @db.Timestamptz
  updatedAt       DateTime           @updatedAt @db.Timestamptz

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id                String       @id @default(uuid())
  productId         Int
  customerId        String?
  customerName      String
  customerEmail     String
  rating            Int
  title             String?
  comment           String
  verifiedPurchase  Boolean      @default(false)
  status            ReviewStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([productId, status])
  @@index([customerEmail])
}
